# Database (SQLite default — PostgreSQL도 지원)
DATABASE_URL=sqlite:///litreview.db

# API Keys
SCOPUS_API_KEY=your_scopus_api_key
SCOPUS_INST_TOKEN=your_institutional_token
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_ENV=development

# Email (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Scheduler
SCHEDULER_TIMEZONE=Asia/Seoul

# Recommendation defaults (tune after testing)
DEFAULT_SIMILARITY_METHOD=top_k_avg
DEFAULT_TOP_K_RATIO=0.2
DEFAULT_CORE_PERCENT=5
DEFAULT_RELATED_PERCENT=15
DEFAULT_REFERENCE_PERCENT=25
DEFAULT_TARGET_YEAR_RANGE=3
DEFAULT_MAX_PAPERS_PER_QUERY=200

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 추천 수집물 전용 DB (instance/ 기준 상대경로 또는 절대경로)
# 논문 본문·초록·임베딩처럼 부피 큰 테이블만 이 파일로 분리한다.
# 런타임에는 ATTACH DATABASE 로 main 에 붙으므로 SQL 조인은 그대로 동작한다.
PAPERS_DATABASE_PATH=reco_papers.db
